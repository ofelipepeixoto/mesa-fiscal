+func TestApresentadorDanfse_TotalDeducoesISSQNNT009(t *testing.T) {
+	for _, tc := range []struct {
+		nome, novosValores, valoresDPS, esperado string
+		visivel                                  bool
+	}{
+		{"novo totalizador", "<vCalcAjusteBCISSQN>85.00</vCalcAjusteBCISSQN>", "", "R$ 85,00", true},
+		{"novo prevalece sem somar fontes", "<vCalcDR>40.00</vCalcDR><vCalcAjusteBCISSQN>85.00</vCalcAjusteBCISSQN>", "<vDedRed><vDR>35.00</vDR></vDedRed>", "R$ 85,00", true},
+		{"zero explícito não recorre ao legado", "<vCalcAjusteBCISSQN>0.00</vCalcAjusteBCISSQN>", "<vDedRed><vDR>35.00</vDR></vDedRed>", "-", false},
+		{"legado mantém origem e exibição", "<vCalcDR>40.00</vCalcDR>", "<vDedRed><vDR>35.00</vDR></vDedRed>", "R$ 35,00", true},
+		{"sem deduções mantém traço", "", "", "-", false},
+	} {
+		t.Run(tc.nome, func(t *testing.T) {
+			entrada := "<NFSe><infNFSe><valores>" + tc.novosValores +
+				"</valores><DPS><infDPS><valores>" + tc.valoresDPS +
+				"</valores></infDPS></DPS></infNFSe></NFSe>"
+			var nota models.NFSe
+			if err := xml.Unmarshal([]byte(entrada), &nota); err != nil {
+				t.Fatal(err)
+			}
+			municipal := NovoServicoApresentacaoDanfse().montarTributacaoMunicipal(nota)
+			if municipal.TotalDeducoes != tc.esperado || municipal.Visivel != tc.visivel {
+				t.Fatalf("deduções/visibilidade: esperado %q/%t, obteve %q/%t", tc.esperado, tc.visivel, municipal.TotalDeducoes, municipal.Visivel)
+			}
+		})
+	}
